+#pragma mark - KaamKoRecord: tab bar slide
+
+// The tab bar slides down and fades out — and back — with the same spring as
+// the app's own top bar (stiffness 320, damping 34, mass 1, no overshoot),
+// instead of UIKit's stock hide.
+//
+// Only the bar itself moves: the controller never marks it hidden. Marking it
+// hidden (UIKit's own way) resizes the page underneath, frame by frame while
+// it animates, and the page shook as the bar came back. The pages already run
+// the full height of the screen under the bar, so there is nothing to resize.
+- (CGFloat)tabBarAwayDistance
+{
+  UITabBar *bar = [_controller tabBar];
+  return CGRectGetHeight(bar.bounds) + _controller.view.safeAreaInsets.bottom + 12;
+}
+
+- (void)placeTabBarHidden:(BOOL)hidden
+{
+  [_tabBarSlide stopAnimation:YES];
+  _tabBarSlide = nil;
+  UITabBar *bar = [_controller tabBar];
+  bar.transform = hidden ? CGAffineTransformMakeTranslation(0, [self tabBarAwayDistance]) : CGAffineTransformIdentity;
+  bar.alpha = hidden ? 0 : 1;
+  bar.userInteractionEnabled = !hidden;
+}
+
+- (void)slideTabBarHidden:(BOOL)hidden
+{
+  UITabBar *bar = [_controller tabBar];
+  // Taking over a slide still under way: carry on from where it is.
+  [_tabBarSlide stopAnimation:YES];
+  _tabBarSlide = nil;
+  const CGFloat away = [self tabBarAwayDistance];
+  bar.userInteractionEnabled = !hidden;
+
+  UISpringTimingParameters *spring = [[UISpringTimingParameters alloc] initWithMass:1
+                                                                          stiffness:320
+                                                                            damping:34
+                                                                    initialVelocity:CGVectorMake(0, 0)];
+  UIViewPropertyAnimator *slide = [[UIViewPropertyAnimator alloc] initWithDuration:0 timingParameters:spring];
+  slide.interruptible = YES;
+  [slide addAnimations:^{
+    bar.transform = hidden ? CGAffineTransformMakeTranslation(0, away) : CGAffineTransformIdentity;
+    bar.alpha = hidden ? 0 : 1;
+  }];
+  _tabBarSlide = slide;
+  [slide startAnimation];
+}
+
 @end
 
