{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://kaamkorecord.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://kaamkorecord.com"
      }
    },
    "production": {
      "autoIncrement": false,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://kaamkorecord.com"
      }
    },
    "production-wear": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://kaamkorecord.com",
        "KAAMKORECORD_WEAR": "1"
      },
      "android": {
        "gradleCommand": ":wear:bundleRelease",
        "applicationArchivePath": "android/wear/build/outputs/bundle/release/*.aab"
      }
    },
    "production-apk": {
      "extends": "production",
      "android": {
        "buildType": "apk"
      },
      "autoIncrement": false
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6813073450"
      },
      "android": {
        "track": "production",
        "releaseStatus": "draft",
        "changesNotSentForReview": true
      }
    }
  }
}
