{
  "expo": {
    "name": "KaamKoRecord",
    "slug": "mywork",
    "platforms": [
      "ios",
      "android"
    ],
    "version": "1.4.4",
    "scheme": "mywork",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.kiranlama.mywork",
      "appleTeamId": "LJ73A8F75U",
      "supportsTablet": true,
      "requireFullScreen": true,
      "entitlements": {
        "com.apple.developer.applesignin": [
          "Default"
        ]
      },
      "infoPlist": {
        "NSCameraUsageDescription": "To photograph picking slips or record a story.",
        "NSPhotoLibraryUsageDescription": "To select picking slips, story media, a profile photo or an optional problem screenshot.",
        "NSMicrophoneUsageDescription": "To record voice messages and sound with a story video.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.kiranlama.merokaam",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#121c2d",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan product and PLU barcodes to search your catalogues."
        }
      ],
      "expo-secure-store",
      "expo-image",
      "expo-video",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#059669"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "To send photos and videos in messages, and to select picking slips, story media, a profile photo or an optional problem screenshot.",
          "cameraPermission": "To take photos and videos to send in messages, photograph picking slips or record a story.",
          "microphonePermission": "To record sound with a video for a message or story."
        }
      ],
      "expo-web-browser",
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "To sign in and unlock the app with Face ID."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#121c2d",
          "android": {
            "image": "./assets/android-icon-foreground.png",
            "imageWidth": 156,
            "resizeMode": "contain",
            "backgroundColor": "#121c2d",
            "dark": {
              "image": "./assets/android-icon-foreground.png",
              "backgroundColor": "#121c2d"
            }
          },
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#121c2d"
          }
        }
      ],
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "widgets": [
            {
              "name": "WorkClock",
              "displayName": "Work clock",
              "description": "Your running shift and next rostered shift. Open the clock to clock in, take a break or clock out.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ],
                "initialLayout": "./src/widgets/WorkWidget.ios.tsx"
              },
              "android": {
                "targetCellWidth": 4,
                "targetCellHeight": 2,
                "initialLayout": "./src/widgets/WorkWidget.android.tsx"
              }
            }
          ]
        }
      ],
      "./plugins/with-work-widget",
      "./plugins/with-compact-android-tabs",
      "@bacons/apple-targets",
      "./plugins/with-watch-version",
      "./plugins/with-wear-app",
      [
        "expo-audio",
        {
          "microphonePermission": "To record voice messages and sound with a story video.",
          "recordAudioAndroid": true
        }
      ],
      "./plugins/with-optional-portrait"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "92546ab9-dfee-46d1-92e7-ca9f77ec73fa"
      }
    }
  }
}
