# Copy to .env next to docker-compose.prod.yml on the VPS and fill in. Never commit .env.
# Keep the old server's values for the secret key, email, push and sign in keys: a new VAPID key
# would switch off everyone's notifications.

DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=kaamkorecord.com,www.kaamkorecord.com

# KaamKoRecord's nginx: the domain it answers and the address Let's Encrypt writes to about the
# certificate (only needed when getting a first certificate).
KAAMKORECORD_DOMAIN=kaamkorecord.com
ACME_EMAIL=

# Links in emails and the sign in return address use this.
PASSWORD_RESET_BASE_URL=https://kaamkorecord.com
SOCIAL_AUTH_BASE_URL=https://kaamkorecord.com

# Email (Brevo)
BREVO_API_KEY=
DEFAULT_FROM_EMAIL=
CONTACT_EMAIL=

# Notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=

# Google and Apple sign in
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY=
